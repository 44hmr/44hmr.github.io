  "red_flags": [
    {
      "id": "F01",
      "name": "重症肺炎与低氧警示（需问清）",
      "description": "发热伴气短提示可能进展为重症肺炎，也可能提示肺栓塞：需问清体温与寒战，并问清活动后气短程度、有无下肢肿痛或制动。两项都问到才算覆盖；病人否认腿肿、无制动，不等于可以不问。",
      "severity": "critical",
      "match": "all",
      "trigger": "P03a 且 P08a 均命中",
      "guideline_source": "《中国成人社区获得性肺炎诊断和治疗指南（2016年版）》重症肺炎判断标准"
    },
    {
      "id": "F02",
      "name": "结核与肿瘤报警症状（需问清）",
      "description": "咯血、盗汗、消瘦提示肺结核或肺部肿瘤，需专门问清；病人阴性也要问过才算排除。",
      "severity": "high",
      "match": "any",
      "trigger": "P08b 命中",
      "guideline_source": "《中国成人社区获得性肺炎诊断和治疗指南（2016年版）》鉴别诊断"
    },
    {
      "id": "F03",
      "name": "病情进展（需问清）",
      "description": "四天内症状逐日加重并新出现气短，提示感染进展，需要评估氧合与收治指征；退烧药暂时退热不等于好转。",
      "severity": "high",
      "match": "any",
      "trigger": "P09 命中",
      "guideline_source": "《中国成人社区获得性肺炎诊断和治疗指南（2016年版）》病情严重程度评估"
    }
  ],
  "standard_approach": [
    {
      "step": "主诉与时间轴",
      "text": "确认咳嗽、咳痰的起病时间、病程和近期变化，先分清急性还是亚急性。"
    },
    {
      "step": "痰液与发热",
      "text": "痰的颜色、量、有无血丝或臭味，发热的最高体温与寒战，是判断细菌感染与肺实质受累的核心。"
    },
    {
      "step": "呼吸危重线索",
      "text": "活动后气短、呼吸频率、下肢肿痛与制动史必须问，用于识别重症肺炎与肺栓塞。"
    },
    {
      "step": "结核与肿瘤报警",
      "text": "咯血、盗汗、消瘦、吸烟史提示肺结核或肺癌，需影像与痰检鉴别。"
    },
    {
      "step": "背景与用药",
      "text": "过敏史（尤其青霉素）、糖尿病、慢阻肺、免疫抑制与近期住院史影响经验性用药选择。"
    },
    {
      "step": "诊疗经过与一般情况",
      "text": "是否拍过胸片、验过血、用过抗生素及疗效，以及饮食睡眠体重，决定下一步检查与收治。"
    }
  ]
}
