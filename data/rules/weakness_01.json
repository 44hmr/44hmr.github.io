  "red_flags": [
    {
      "id": "F01",
      "name": "颅内出血警示（需问清）",
      "description": "突发神经功能缺损必须先与脑出血鉴别：需问清起病方式（突发还是渐进），并问清有无头痛、呕吐、意识改变、抽搐与头部外伤。两项都问到才算覆盖；病人否认头痛呕吐，不等于可以不问。",
      "severity": "critical",
      "match": "all",
      "trigger": "P03a 且 P08a 均命中",
      "guideline_source": "《中国脑出血诊治指南（2019）》急性脑卒中急诊评估"
    },
    {
      "id": "F02",
      "name": "低血糖与心源性栓塞（需问清）",
      "description": "服用磺脲类降糖药者出现神经症状必须先排除低血糖；房颤患者需问清心慌、胸闷等心源性线索。需问清出汗、心慌、手抖、饥饿感与胸闷胸痛。",
      "severity": "critical",
      "match": "any",
      "trigger": "P08b 命中",
      "guideline_source": "《中国急性缺血性脑卒中诊治指南 2023》院前与急诊评估"
    },
    {
      "id": "F03",
      "name": "病情进展（需问清）",
      "description": "两小时内症状是否加重、有无新出现意识改变，直接影响再灌注治疗方案的选择；病人主诉“没更厉害”也要问过才算记录。",
      "severity": "high",
      "match": "any",
      "trigger": "P09 命中",
      "guideline_source": "《中国急性缺血性脑卒中诊治指南 2023》病情评估"
    }
  ],
  "standard_approach": [
    {
      "step": "主诉与最后正常时间",
      "text": "先确定最后正常时间而非仅问“多久了”，这是静脉溶栓时间窗判断的起点。"
    },
    {
      "step": "缺损分布与起病方式",
      "text": "单侧上下肢加面部的突然缺损提示血管性病变；数分钟内达最重支持缺血性卒中，波动或渐进需另作考虑。"
    },
    {
      "step": "神经功能与出血线索",
      "text": "言语、吞咽、视力、麻木与共济逐项问清；头痛、呕吐、意识改变、抽搐与外伤用于排除脑出血。"
    },
    {
      "step": "低血糖与心源性",
      "text": "磺脲类降糖药与房颤是必须问清的两条线：低血糖可完全模拟卒中，房颤提示心源性栓塞。"
    },
    {
      "step": "背景与用药",
      "text": "高血压、糖尿病、吸烟、既往卒中/TIA 与抗凝药使用，决定再灌注的出血风险与二级预防。"
    },
    {
      "step": "诊疗经过与一般情况",
      "text": "是否已测血糖、做过 CT，发病后是否进食服药，以及家属发现时间与基线功能状态。"
    }
  ]
}
