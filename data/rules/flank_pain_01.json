  "red_flags": [
    {
      "id": "F01",
      "name": "梗阻合并感染（需问清）",
      "description": "结石梗阻合并感染可迅速进展为脓毒症：需问清有无发热寒战，并问清尿频尿急尿痛、血尿与尿量。两项都问到才算覆盖；病人目前无发热，不等于可以不问。",
      "severity": "critical",
      "match": "all",
      "trigger": "P08a 且 P08b 均命中",
      "guideline_source": "EAU Guidelines on Urolithiasis (2023) 感染性梗阻的处理"
    },
    {
      "id": "F02",
      "name": "疼痛持续不缓解（需问清）",
      "description": "反复绞痛且间隔变短、无缓解趋势，提示结石可能嵌顿并造成梗阻，需评估肾积水与肾功能。",
      "severity": "high",
      "match": "any",
      "trigger": "P09 命中",
      "guideline_source": "《中国泌尿外科和男科疾病诊断治疗指南（2019版）》尿石症"
    },
    {
      "id": "F03",
      "name": "非典型危重疼痛（需排除）",
      "description": "突发撕裂样腰背痛并向背部放射需警惕腹主动脉夹层或破裂：需问清疼痛性质与放射部位。两项都问到才算覆盖；本例为绞痛并向会阴放射，仍必须先问清。",
      "severity": "critical",
      "match": "all",
      "trigger": "P03a 且 P06 均命中",
      "guideline_source": "《急性腹痛诊断与治疗专家共识》血管性腹痛鉴别"
    }
  ],
  "standard_approach": [
    {
      "step": "主诉与时间轴",
      "text": "确认腰痛/侧腹痛的起病方式、病程与当前发作频率，区分突发绞痛与持续胀痛。"
    },
    {
      "step": "疼痛特征",
      "text": "绞痛、阵发、向腹股沟会阴放射是输尿管结石的典型表现；撕裂样并向背部放射要警惕血管病变。"
    },
    {
      "step": "排尿与感染",
      "text": "尿频尿急尿痛、肉眼血尿、尿量减少和发热寒战，决定是否存在梗阻合并感染。"
    },
    {
      "step": "鉴别问诊",
      "text": "睾丸肿痛排除睾丸扭转，转移性右下腹痛排除阑尾炎，女性需排除妇科急症。"
    },
    {
      "step": "背景与结石风险",
      "text": "既往结石史、痛风、饮水少、家族史与职业出汗多，都是复发与病因评估的线索。"
    },
    {
      "step": "诊疗经过与一般情况",
      "text": "是否做过 B 超、尿常规，是否用过止痛药及疗效，以及饮食睡眠体重，决定下一步影像与镇痛方案。"
    }
  ]
}
