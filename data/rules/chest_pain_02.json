  "standard_approach": [
    { "step": "主诉与时间轴", "text": "先确认主诉，问清胸痛与反酸的起病时间、病程和近期变化。" },
    { "step": "典型反流症状", "text": "烧心、反酸、餐后及卧位加重、抗酸药缓解，是 GERD 的核心线索。" },
    { "step": "心脏危险信号", "text": "压榨样疼痛、向左肩臂/下颌放射、大汗、气短、劳力诱发必须先问，必要时查心电图与肌钙蛋白。" },
    { "step": "消化道报警症状", "text": "吞咽困难、吞咽痛、消瘦、黑便、呕血、贫血提示器质性疾病，需胃镜评估。" },
    { "step": "诱因与生活方式", "text": "饱餐、夜宵、浓茶咖啡、饮酒、吸烟、肥胖及体位因素都可加重反流。" },
    { "step": "背景与诊疗经过", "text": "过敏史、既往病史、用药史、家族史与既往检查逐项补充，尤其确认是否做过胃镜。" }
  ]
