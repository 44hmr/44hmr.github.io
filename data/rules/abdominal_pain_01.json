  "standard_approach": [
    { "step": "主诉与时间轴", "text": "先确认主诉，问清腹痛的起病时间、持续时间及近期变化。" },
    { "step": "转移性右下腹痛", "text": "疼痛是否由脐周转移并固定于右下腹，是急性阑尾炎最重要的问诊线索。" },
    { "step": "疼痛特征与腹膜刺激", "text": "问清性质、程度，以及活动、咳嗽或翻身是否加重；压痛、反跳痛属于体格检查，问诊阶段先用这些活动相关表现间接判断腹膜刺激。" },
    { "step": "伴随症状", "text": "恶心、呕吐、食欲不振、低热提示感染与消化道受累；同时问清尿路及睾丸症状，避免漏诊泌尿生殖系统疾病。" },
    { "step": "鉴别诊断", "text": "重点排除消化道穿孔、右侧输尿管结石、右侧睾丸扭转等急需处理的疾病；女性患者补充月经史与妇科情况。" },
    { "step": "背景与诊疗经过", "text": "补充过敏史、基础病、既往腹痛或阑尾炎史、手术外伤史、家族史及本次就诊前的检查和用药。" }
  ]
