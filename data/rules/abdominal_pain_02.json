  "standard_approach": [
    { "step": "主诉与时间轴", "text": "先确认主诉，问清腹痛的起病时间、起病方式及近期变化。" },
    { "step": "育龄女性先排除妊娠", "text": "问清末次月经、有无停经及阴道流血，这是异位妊娠最重要的问诊线索；不能只问腹痛。" },
    { "step": "腹痛特征与腹腔内出血", "text": "问清疼痛性质、程度、肩部牵涉痛、肛门坠胀，以及头晕、晕厥、出冷汗、心慌等循环不足表现；腹部压痛、反跳痛及宫颈举痛属于体格检查。" },
    { "step": "伴随症状与鉴别", "text": "恶心呕吐、发热、尿路症状需与阑尾炎、泌尿系结石、盆腔炎等鉴别；腹泻与反酸腹胀有助于排除消化道疾病。" },
    { "step": "鉴别诊断与检查", "text": "重点排除卵巢囊肿破裂或扭转、急性阑尾炎等急需处理的疾病；β-hCG、经阴道超声、血常规、血型及交叉配血是关键的下一步评估。" },
    { "step": "背景与诊疗经过", "text": "补充盆腔炎、既往异位妊娠、盆腔手术等危险因素，以及过敏史、吸烟史、手术外伤史、家族史和本次就诊前的检查用药。" }
  ]
}
