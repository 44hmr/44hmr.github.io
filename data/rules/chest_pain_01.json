  "standard_approach": [
    { "step": "起病", "text": "先确认主诉，问清起病时间与起病方式，建立时间轴。" },
    { "step": "定位定性", "text": "部位、性质、放射、持续时间，构成 OPQRST 骨架。" },
    { "step": "诱因", "text": "发作诱因与缓解因素，重点问含服硝酸甘油的反应。" },
    { "step": "伴随", "text": "大汗、恶心、心悸、呼吸困难等高危伴随征象必须逐项排查。" },
    { "step": "演变", "text": "发作频率与程度的变化，判断是否由稳定转为不稳定。" },
